NODE_ENV=production
PORT=4001

WEB_URL=https://smartreach.memoryconnect.co.za

DATABASE_URL=file:/data/smartreach.db

# JWT secrets are NOT tracked here. They are injected by docker compose from
# an untracked .env file on the VM (see README "Production Deployment").
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

AI_PROVIDER=template
AI_PROVIDER_FALLBACK=template

WORKER_POLL_INTERVAL_MS=15000

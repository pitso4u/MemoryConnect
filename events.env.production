# Events API production config (tracked, non-secret only).
# Secrets are NEVER stored here. They are injected on the VM via an
# untracked .env file (same convention as smartreach):
#
#   cat > .env <<'EOF'
#   EVENTS_JWT_SECRET=<generate-a-long-random-value>
#   EVENTS_PAYSTACK_SECRET_KEY=<Paystack secret key dedicated to Events>
#   EOF
#
# docker compose fails loudly if EVENTS_JWT_SECRET is missing (see the :?
# guard in docker-compose.events.yml), so Events can never boot with a
# fallback secret.
NODE_ENV=production
HOST=0.0.0.0
PORT=4101

EVENTS_DATABASE_URL=file:/data/events.db
EVENTS_JWT_EXPIRES_IN=7d
EVENTS_CORS_ORIGIN=https://events.memoryconnect.co.za
EVENTS_UPLOADS_DIR=/app/uploads
EVENTS_PUBLIC_URL=https://events.memoryconnect.co.za
EVENTS_PAYSTACK_SECRET_KEY=
EVENTS_AUTH_RATE_LIMIT_MAX=10
EVENTS_MESSAGE_RATE_LIMIT_MAX=5

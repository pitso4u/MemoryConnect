FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY apps/sales-crm/package*.json apps/sales-crm/
COPY packages packages

RUN npm install

COPY . .

RUN npm run build -w @memorialconnect/shared
RUN npm run build -w @memorialconnect/sales-crm

FROM nginx:alpine

COPY --from=builder /app/apps/sales-crm/dist /usr/share/nginx/html
COPY nginx/crm.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

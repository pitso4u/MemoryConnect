{
  "name": "@memorialconnect/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "tsx src/scripts/prepareDatabase.ts && prisma db push --skip-generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "seed:crm": "tsx src/scripts/seed-crm.ts",
    "reset:demo": "node dist/scripts/seed-demo.js",
    "seed:features": "tsx src/scripts/seed-features.ts",
    "reset:test-data": "tsx src/scripts/reset-test-data.ts",
    "reset:test-data:dry-run": "tsx src/scripts/reset-test-data.ts --dry-run",
    "reset:test-data:confirm": "tsx src/scripts/reset-test-data.ts --confirm",
    "test": "vitest"
  },
  "dependencies": {
    "@memorialconnect/shared": "*",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nanoid": "^3.3.8",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.3.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

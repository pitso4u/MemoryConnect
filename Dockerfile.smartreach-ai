FROM node:22-alpine AS builder

WORKDIR /app

COPY . .

RUN npm ci

RUN npm run db:generate -w @smartreach/api
RUN npm run build -w smartreach-ai

FROM node:22-alpine

RUN apk add --no-cache nginx

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/smartreach-ai ./apps/smartreach-ai
COPY --from=builder /app/apps/smartreach-ai/apps/web/dist /usr/share/nginx/html
COPY nginx/smartreach.conf /etc/nginx/http.d/default.conf

EXPOSE 80

CMD ["sh", "-c", "npx prisma db push --skip-generate --schema=apps/smartreach-ai/apps/api/prisma/schema.prisma && node apps/smartreach-ai/apps/api/dist/index.js & exec nginx -g 'daemon off;'"]

# ===== API =====
PORT=4001
NODE_ENV=development
APP_URL=http://localhost:4001
WEB_URL=http://localhost:5175

# Database (SQLite for local dev / demo. For Postgres set DATABASE_URL to a postgresql:// string)
DATABASE_URL="file:./smartreach.db"

# JWT secrets — change in production
JWT_SECRET=change-me-super-secret-access
JWT_REFRESH_SECRET=change-me-super-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== AI PROVIDER =====
# Available providers: "ollama" | "openrouter" | "template"
#   "template"  -> no external calls, deterministic generator (works offline)
#   "ollama"    -> local LLM via Ollama (OpenAI-compatible /v1 endpoint)
#   "openrouter"-> hosted LLM via OpenRouter (OpenAI-compatible endpoint)
AI_PROVIDER=template
AI_PROVIDER_FALLBACK=template

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b 
OLLAMA_TEMPERATURE=0.7

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7

# ===== WORKER / SCHEDULING =====
# Milliseconds between publish polling sweeps
WORKER_POLL_INTERVAL_MS=15000
# Publish window simulation: seconds added to "now" for demo due-posts
SIMULATE_TIME_DELTA_SECONDS=0
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY apps/events/package*.json apps/events/
COPY packages packages

RUN npm install

COPY . .

# Production API endpoint baked in at build time. No localhost fallback.
ARG VITE_EVENTS_API_URL=https://events-api.memoryconnect.co.za
ENV VITE_EVENTS_API_URL=${VITE_EVENTS_API_URL}

RUN npm run build -w @memorialconnect/event-shared
RUN npm run build -w @memorialconnect/events

FROM nginx:alpine

COPY --from=builder /app/apps/events/dist /usr/share/nginx/html
COPY nginx/events.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
